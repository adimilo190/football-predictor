# Copy this file as ".env" and fill in the real values.
# .env is listed in .gitignore, so secrets never leave your machine.

# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/football_db

# Key from https://dashboard.api-football.com
API_FOOTBALL_KEY=YOUR_API_KEY

# Secret guarding the admin-only POST /import-* endpoints (X-Import-Token header).
# Generate your own: venv/bin/python -c "import secrets; print(secrets.token_urlsafe(32))"
IMPORT_TOKEN=GENERATE_YOUR_OWN_TOKEN

# Frontend origins allowed to call this API from a browser (CORS).
# Locally: the Vite dev server. In production: the deployed frontend domain,
# e.g. https://football-predictor.vercel.app
# Separate several origins with commas: http://localhost:5173,https://app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173
