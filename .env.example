# Skopiuj ten plik jako ".env" i uzupełnij prawdziwymi wartościami.
# Plik .env jest w .gitignore - sekrety zostają tylko na Twoim komputerze.

# Format: postgresql://uzytkownik:haslo@serwer:port/nazwa_bazy
DATABASE_URL=postgresql://postgres:TWOJE_HASLO@localhost:5432/football_db

# Klucz z panelu https://dashboard.api-football.com
API_FOOTBALL_KEY=TWOJ_KLUCZ_API
