# === Secrets - NEVER commit these! ===
# .env holds passwords and API keys. Only .env.example (a template with no real
# values) is allowed on GitHub.
.env
# Extra safety net: common filenames for secrets and tokens.
.env.*
!.env.example
*.token
*.secret
secrets.txt
credentials.txt

